# Upstash Redis (Vercel Marketplace) — required for session state to persist
# across requests/regions. Without these, the API silently falls back to
# in-memory defaults on every request (fine for local UI testing, useless
# for a real show since nothing is saved).
UPSTASH_KV_REST_API_URL="https://your-instance.upstash.io"
UPSTASH_KV_REST_API_TOKEN="your-upstash-token"
